      b += V(v >= 0 ? X(v) + 4 : X(v) - 4, y + row / 2 + 2, txt, key, v >= 0 ? "start" : "end", `style="font-size:11.5px;${v < 0 ? "fill:" + css("--neg") : ""}"`);
    });
