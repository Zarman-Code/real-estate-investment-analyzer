        ${uncertain.length ? `<div class="uncertain-box"><b>Évaluation incertaine</b> (hors matrice) : ${uncertain.map(r => `<button type="button" class="chip" data-risk="${esc(r.id)}">◌ ${lbl(r.id + " " + r.title)}</button>`).join(" ")}</div>` : ""}</div>
