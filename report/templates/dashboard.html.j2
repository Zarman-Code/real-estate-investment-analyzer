    : `Comparaison avec les transactions non disponible ${fmt("financials.price_vs_median_pct")}.`;
  const fig = Fig(), figY = Fig();
  const rows = [{ label: "Transactions (toutes surfaces)", key: "market.dvf_price_per_sqm", q1: "q1", med: "median", q3: "q3", n: "n" }];
  if (val("market.dvf_price_per_sqm", ["large_lots", "median"]) !== null)
    rows.push({ label: "Transactions (grandes surfaces)", key: "market.dvf_price_per_sqm", q1: "large_lots.q1", med: "large_lots.median", q3: "large_lots.q3", n: "large_lots.n" });
  Object.keys(D.datapoints).filter(k => /^market\.dvf_price_per_sqm@\d+$/.test(k)).forEach(k => rows.push({ label: `Recoupement : ${dpOf(k).source_name.split(" - ")[0]}`, key: k, med: "median", n: "n" }));
