    let b = "";
    niceTicks(0, hi, 3).forEach(t => { b += `<line class="gridl" x1="${X(t)}" x2="${X(t)}" y1="${top - 4}" y2="${H - 24}"/>` + T(X(t), H - 6, nf(t, 0), "tick", "middle"); });
    rows.forEach((r, i) => {
      const y = top + i * row + row / 2, q1 = val(r.key, r.q1), med = val(r.key, r.med), q3 = val(r.key, r.q3), cnt = val(r.key, r.n);
      b += T(L - 10, y - 3, r.label, "lab", "end") + `<text x="${L - 10}" y="${y + 13}" class="tick" text-anchor="end" style="font-size:11px">${esc(r.after ? "base surface après travaux" : isNum(cnt) ? fig.n(r.key, cnt, "int") + " transactions" : "")}</text>`;
      if (isNum(q1) && isNum(q3)) { b += `<rect x="${X(q1)}" y="${y - 9}" width="${X(q3) - X(q1)}" height="18" rx="4" fill="${css("--accent-soft")}" stroke="${css("--accent")}"><title>1er au 3e quartile : ${esc(FORMATS.sqm(q1))} à ${esc(FORMATS.sqm(q3))}</title></rect>`; fig.use(r.key); }
      if (isNum(med)) {
        // étiquette de la médiane posée au-dessus de la barre : elle ne touche ni le quartile ni la ligne du prix demandé
        const xm = X(med), right = !isNum(ask) || ask <= med ? xm < R - 80 : xm < L + 80;
        b += `<line x1="${xm}" x2="${xm}" y1="${y - 11}" y2="${y + 11}" stroke="${css("--accent")}" stroke-width="3"/>` + V(right ? xm + 4 : xm - 4, y - 14, fig.n(r.key, med, "sqm"), r.key, right ? "start" : "end", 'style="font-size:12px"');
      } else fig.use(r.key);
    });
    if (isNum(ask)) {
      const xa = X(ask), anchor = xa > R - 120 ? "end" : "middle";
      b += `<line x1="${xa}" x2="${xa}" y1="${top - 12}" y2="${H - 24}" stroke="${css("--nogo")}" stroke-width="2" stroke-dasharray="5 3"/>` + `<text x="${xa}" y="${top - 18}" class="val" data-key="financials.price_per_sqm_asked" text-anchor="${anchor}" style="fill:${css("--nogo")}">${esc("prix demandé " + fig.n("financials.price_per_sqm_asked", ask, "sqm"))}</text>`;
    }
    chart = svg(W, H, b, "prix au mètre carré : prix demandé et transactions") + `<div class="legend"><span><i style="background:${css("--accent-soft")};border:1px solid ${css("--accent")}"></i>${lbl("du 1er au 3e quartile")}</span><span><i style="background:${css("--accent")}"></i>médiane</span><span><i style="background:${css("--nogo")}"></i>prix demandé (surface avant travaux)</span></div>`;
  }
