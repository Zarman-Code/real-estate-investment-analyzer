    db += `<rect x="${x}" y="${B - hh}" width="${w}" height="${hh}" rx="3" fill="${css("--c1")}" fill-opacity=".75"/>` + T(x + w / 2, B + 16, c, "lab", "middle", 'style="font-weight:700"');
    if (isNum(v)) db += V(x + w / 2, B - hh - 5, figD.n("energy.dpe_comparables", v, "int"), "energy.dpe_comparables", "middle");
    if (c === cur) db += T(x + w / 2, B + 32, "▼ actuel", "lab", "middle", `style="fill:${css("--nogo")};font-weight:600"`);
