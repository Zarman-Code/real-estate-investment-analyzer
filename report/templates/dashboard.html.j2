    ${fold("scenarios-detail", "Détail des scénarios", sumKey,
      `${assumptions}<div class="grid g2"><div><h3>Marge et TRI par scénario</h3>${chart}${fig.caption()}</div><div><h3>Prix maximum par scénario : marge de sécurité</h3>${price}${figP.caption()}</div></div>`)}`;
