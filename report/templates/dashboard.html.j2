// frise tirée de deal.operation.timeline (datapoint deal.timeline) et des baux en place
function timeline(fig) {
  const tl = val("deal.timeline"); fig.use("deal.timeline");
  const need = tl && ["acquisition_date", "works_start", "works_duration_months", "letting_year", "exit_year"].every(k => tl[k] !== null && tl[k] !== undefined);
  if (!need) return `<p class="box na">Calendrier non disponible ${fmt("deal.timeline")}.</p>`;
  const leases = val("deal.current_leases") || []; if (leases.length) fig.use("deal.current_leases");
  const toT = s => Date.parse(String(s).slice(0, 10) + "T00:00:00Z");
  const addM = (s, m) => { const d = new Date(toT(s)); d.setUTCMonth(d.getUTCMonth() + m); return d.toISOString().slice(0, 10); };
  const worksEnd = addM(tl.works_start, tl.works_duration_months);
  const t0 = toT(tl.acquisition_date), t1 = toT(`${tl.exit_year}-12-31`);
  const rows = [];
  leases.forEach(l => rows.push(["Bail en place", tl.acquisition_date, l.end_date, css("--c4"), "jusqu'au " + FORMATS.date(l.end_date), 1]));
  rows.push(["Travaux", tl.works_start, worksEnd, css("--c2"), FORMATS.months(tl.works_duration_months), 1]);
