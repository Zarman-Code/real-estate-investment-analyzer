    `<p class="small">Dernière valeur ${fmt("rates.euribor_3m", { format: "pct2" })} ; ${lbl("moyenne sur 12 mois")} ${fmt("rates.euribor_3m", { field: "avg_12m", format: "pct2" })} ; hypothèse centrale du modèle ${fmt("params.euribor", { format: "pct2" })}.</p>`,
