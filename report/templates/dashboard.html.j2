  const k = "risks." + r.id, fe = r.financial_effect;
  const ev = r.evidence.map((e, i) => `<li>${lbl((e && e.label) || "élément")} : ${fmt(`${k}.evidence.${i}`)}</li>`).join("");
  box.innerHTML = `<p class="small muted">${esc((CAT[r.category] || [r.category])[0])} · niveau <b>${esc(r.level)}</b>${r.uncertain ? " · évaluation incertaine" : ""}</p>
    <p class="prose">${esc(r.description)}</p>
    <table class="small"><tr><th scope="row">Probabilité</th><td>${fmt(k + ".probability", { format: "prob" })} — ${fmt(k + ".probability_rationale")}</td></tr>
      <tr><th scope="row">Impact</th><td>${fmt(k + ".impact", { format: "prob" })} — ${fmt(k + ".impact_rationale")}</td></tr>
      <tr><th scope="row">Criticité</th><td>${fmt(k + ".criticality", { format: "crit" })}</td></tr>
      ${fe ? `<tr><th scope="row">Effet chiffré</th><td>si le risque survient (${fmt(k + ".shock")}) : marge ${fmt(k + ".delta_margin_pts", { format: "pts" })}, TRI fonds propres ${fmt(k + ".delta_irr_pts", { format: "pts" })}</td></tr>` : ""}</table>
    ${ev ? `<h3>Éléments justificatifs</h3><ul class="small">${ev}</ul>` : ""}
    <h3>Mesures de réduction</h3><ul class="small">${r.mitigations.map(m => `<li>${lbl(m)}</li>`).join("")}</ul>
    ${r.financial_link.length ? `<p class="small">Indicateurs affectés : ${lbl(r.financial_link.join(", "))}</p>` : ""}
    ${(r.missing_information || []).length ? `<div class="box warn small">Information manquante : ${lbl(r.missing_information.join(" ; "))}</div>` : ""}`;
}

// ================================================================== annexes : sources (repliées)
function renderAnnexes() {
  $("annexes-body").innerHTML = `<div id="src-wrap"></div>`;
  safe(renderSources, "src-wrap");
}
function renderSources() {
  const CATS = [["Transactions", /^market\.dvf/], ["Marché locatif", /^market\.(average_rent|prime_rent|take_up|immediate_supply|vacancy|incentives|future_supply)/],
                ["Rendements et valeurs", /^market\.(investment_price|prime_yield)/], ["Taux et indices", /^(rates|index)\./],
                ["Réglementation et environnement", /^(urbanism|energy|risk)\./], ["Localisation", /^location\./], ["Dossier de l'opération", /^deal\./]];
  const catOf = s => (CATS.find(([, re]) => s.used_for.some(k => re.test(k))) || ["Autres"])[0];
  const groups = {}; D.sources.forEach(s => (groups[catOf(s)] = groups[catOf(s)] || []).push(s));
  const order = [...CATS.map(c => c[0]), "Autres"].filter(c => groups[c]);
  const names = D.sources.map(s => s.name.split(" - ")[0].split(" (")[0]).filter((v, i, a) => a.indexOf(v) === i);
  $("src-wrap").innerHTML = fold("sources", "Sources", `${lbl(names.slice(0, 4).join(", ") + (names.length > 4 ? "…" : ""))}`,
    order.map(c => `<h3>${esc(c)}</h3><table><thead><tr><th>Source</th><th>Date de la donnée</th><th>Utilisée pour</th></tr></thead><tbody>
      ${groups[c].map(s => `<tr><td><b>${lbl(s.name)}</b>${s.url ? `<br><a class="small lbl" href="${esc(s.url)}" target="_blank" rel="noopener noreferrer">${esc(s.url.length > 90 ? s.url.slice(0, 90) + "…" : s.url)}</a>` : ""}</td><td>${wrapDate(s.data_date || "non précisée")}</td><td class="small">${s.used_for.map(k => lbl(labelOf(k))).join(", ")}</td></tr>`).join("")}</tbody></table>`).join(""));
}

// ================================================================== montage, navigation, déplier / replier
function safe(fn, target) {
  try { fn(); } catch (e) {
    console.error(e);
    const el = $(target);
    if (el) el.insertAdjacentHTML("beforeend", `<div class="section-error" role="alert">Cette section n'a pas pu être affichée : ${esc(e.message)}</div>`);
  }
}
$("brand").textContent = D.meta.asset_name;
$("brand-date").innerHTML = `analyse du ${wrapDate(FORMATS.date(D.meta.analysis_date))}`;
[[renderVerdict, "verdict-body"], [renderNote, "note-body"], [renderOperation, "operation-body"], [renderPrice, "prix-body"], [renderRent, "loyer-body"],
 [renderMarket, "marche-body"], [renderCost, "cout-body"], [renderReturns, "rentabilite-body"], [renderSensitivity, "sensibilites-body"],
 [renderScenarios, "scenarios-body"], [renderRisks, "risques-body"], [renderAnnexes, "annexes-body"]].forEach(([f, t]) => safe(f, t));
$("footer").innerHTML = `Généré le ${wrapDate(FORMATS.date(D.meta.generated_at))} à partir des sorties de l'agent. Contour pointillé autour d'une valeur : confiance faible. Valeur en italique : hypothèse.`;
$("modified-banner").hidden = true;                             // A2 : état initial masqué, quel que soit le rendu du simulateur
// A3 : tout déplier / tout replier
$("toggle-all").addEventListener("click", () => {
  const open = $("toggle-all").getAttribute("aria-pressed") !== "true";
  document.querySelectorAll("details.fold").forEach(d => { d.open = open; });
  $("toggle-all").setAttribute("aria-pressed", String(open)); $("toggle-all").textContent = open ? "Tout replier" : "Tout déplier";
});
// A1 : section active en surbrillance
const navLinks = [...document.querySelectorAll("nav.anchors a")];
const setActive = g => navLinks.forEach(a => a.setAttribute("aria-current", a.dataset.group === g ? "true" : "false"));
function updateActive() {
  const line = 48 + 80; let g = "verdict";
  document.querySelectorAll("section.block[data-group]").forEach(s => { if (s.getBoundingClientRect().top <= line) g = s.dataset.group; });
  if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) g = "annexes";
  setActive(g);
}
window.addEventListener("scroll", () => { window.requestAnimationFrame(updateActive); }, { passive: true });
updateActive();
// impression : tous les blocs repliés sont imprimés dépliés, puis l'état d'écran est rétabli
let printState = null;
window.addEventListener("beforeprint", () => { printState = [...document.querySelectorAll("details.fold")].map(d => [d, d.open]); printState.forEach(([d]) => { d.open = true; }); });
window.addEventListener("afterprint", () => { (printState || []).forEach(([d, o]) => { d.open = o; }); printState = null; });
{% endraw %}
</script>
</body>
</html>
