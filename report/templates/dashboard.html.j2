  const W = 640, L = 230, R = W - 12, row = 32, H = rows.length * row + 40, X = v => L + (v + m) / (2 * m) * (R - L);
  let b = `<line class="axis" x1="${X(0)}" x2="${X(0)}" y1="0" y2="${H - 26}"/>`;
  niceTicks(-m, m, 4).forEach(t => { b += T(X(t), H - 8, (t > 0 ? "+" : "") + nf(t, 0), "tick", "middle"); });
  rows.forEach((r, i) => {
