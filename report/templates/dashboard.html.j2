// ================================================================== B. note go/no-go (lue dans DATA.recommendation.note)
const noteHtml = line => fmtText(line).replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>").replace(/(^|[ ;:])(\d)\) /g, (m, a, n) => `${a}${lbl(n + ")")} `);
function renderNote() {
  const list = items => items.length ? `<ul class="args">${items.map(t => `<li>${fmtText(t)}</li>`).join("")}</ul>` : `<p class="muted small">Aucun élément.</p>`;
  const plain = items => items.length ? `<ul class="args">${items.map(t => `<li>${lbl(t)}</li>`).join("")}</ul>` : `<p class="muted small">Aucun élément.</p>`;
  const first = items => items.length ? `${fmtText(items[0])}${items.length > 1 ? ` <span class="muted">(et d'autres)</span>` : ""}` : "aucun";
  const note = REC.note || [];
  $("note-body").innerHTML = (note.length
    ? `<div class="note-box" id="note-text">${note.map(l => `<p>${noteHtml(l)}</p>`).join("")}</div>
       <div class="note-actions"><button type="button" class="btn" id="copy-note">Copier la note</button><span class="copied" id="copy-done" role="status"></span></div>`
    : `<p class="box na">Note non générée : l'agent n'a pas produit de note pour cette analyse.</p>`)
    + explanationHtml()
    + fold("note-pros", "Arguments favorables", first(REC.pros), list(REC.pros))
    + fold("note-cons", "Arguments défavorables", first(REC.cons), list(REC.cons))
    + fold("note-kpi", "Indicateurs déterminants", REC.key_indicators.slice(0, 2).map(k => `${lbl(labelOf(k))} ${fmt(k)}`).join(" · "),
           `<div class="tiles">${REC.key_indicators.map(k => `<div class="tile"><div class="k">${lbl(labelOf(k))}</div><div class="val">${fmt(k, { pill: "word" })}</div></div>`).join("")}</div>`)
    + fold("note-cond", REC.decision === "NO_GO" ? "Conditions d'un réexamen" : "Conditions avant validation", first(REC.conditions), list(REC.conditions))
    + fold("note-missing", "Informations manquantes", REC.missing_information.length ? lbl(REC.missing_information[0]) + (REC.missing_information.length > 1 ? ` <span class="muted">(et d'autres)</span>` : "") : "aucune", plain(REC.missing_information));
  const copy = (id, text, msg) => { const b = $(id); if (!b) return; b.addEventListener("click", () => {
    const done = () => { $("copy-done").textContent = msg; };
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text()).then(done, () => fallbackCopy(text(), done)); else fallbackCopy(text(), done);
  }); };
  copy("copy-note", () => note.map(l => textPlain(l).replace(/\*\*/g, "")).join("\n"), "Note copiée.");
  copy("copy-expl", () => (REC.explanation || []).map(s => s.title.toUpperCase() + "\n" + s.paragraphs.map((p, i) => (i ? "- " : "") + textPlain(p)).join("\n")).join("\n\n"), "Explication copiée.");
}
// texte explicatif final : décision et raisons, risques déclarés, hypothèses à valider, seuils de bascule
function explanationHtml() {
  const ex = REC.explanation || [];
  if (!ex.length) return `<p class="box na">Explication non générée (relancer l'agent pour l'obtenir).</p>`;
  return `<div class="explanation" id="explanation"><h3 class="expl-title">Explication de la décision</h3>
    ${ex.map(s => `<section class="expl-sec" aria-label="${esc(s.title)}"><h4>${esc(s.title)}</h4>${s.paragraphs.length ? `<p class="prose">${fmtText(s.paragraphs[0])}</p>` : ""}
      ${s.paragraphs.length > 1 ? `<ul class="args">${s.paragraphs.slice(1).map(p => `<li>${fmtText(p)}</li>`).join("")}</ul>` : ""}</section>`).join("")}
    <div class="note-actions"><button type="button" class="btn" id="copy-expl">Copier l'explication</button></div></div>`;
}
function fallbackCopy(text, done) {
  const t = document.createElement("textarea"); t.value = text; t.setAttribute("readonly", ""); t.style.position = "fixed"; t.style.opacity = "0";
  document.body.appendChild(t); t.select(); try { document.execCommand("copy"); done(); } catch (e) { $("copy-done").textContent = "Copie impossible : sélectionner le texte."; } t.remove();
}

// ================================================================== E15. L'opération en un coup d'œil (repliée)
