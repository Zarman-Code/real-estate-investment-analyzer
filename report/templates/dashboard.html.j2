    b += inside ? T(xa + 8, y + 17, note, "tick", "start", 'style="fill:#1b1f24"') : T(xa + w + 6 > R - 110 ? xa - 6 : xa + w + 6, y + 17, note, "tick", xa + w + 6 > R - 110 ? "end" : "start");
  });
  b += `<line x1="${L}" x2="${L}" y1="2" y2="${H - 24}" stroke="${css("--ink")}" stroke-width="1.5"/>` + T(L + 4, H - 8, "acquisition " + FORMATS.date(tl.acquisition_date), "tick", "start", 'style="font-weight:600"');
