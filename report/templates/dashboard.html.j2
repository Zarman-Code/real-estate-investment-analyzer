}
function locationMap(fig, geo) {
  fig.use("location.reference_point");
  const lat0 = val("location.reference_point", "lat"), lon0 = val("location.reference_point", "lon");
  if (!isNum(lat0) || !isNum(lon0)) return `<p class="box na">Point de référence non géocodé : schéma non disponible.</p>`;
  const kx = 111320 * Math.cos(lat0 * Math.PI / 180), ky = 110540, toM = (lon, lat) => [(lon - lon0) * kx, (lat - lat0) * ky];
  let extent = 300; const shapes = [];
  const bbox = val("market.dvf_price_per_sqm", "bbox");
  if (bbox) { fig.use("market.dvf_price_per_sqm"); const [x1, y1, x2, y2] = String(bbox).split(",").map(Number); const a = toM(x1, y1), c = toM(x2, y2); shapes.push(["rect", a, c]); extent = Math.max(extent, ...[a, c].flat().map(Math.abs)); }
  const rA = val("energy.dpe_comparables", "radius_m");
  if (isNum(rA)) { fig.use("energy.dpe_comparables"); shapes.push(["circle", rA]); extent = Math.max(extent, rA); }
  const tx = MK.transactions.filter(t => isNum(t.lat) && isNum(t.lon));
  tx.forEach(t => { const [x, y] = toM(t.lon, t.lat); extent = Math.max(extent, Math.abs(x), Math.abs(y)); });
  extent *= 1.15;
  const W = geo ? 440 : 260, H = geo ? 320 : 200, s = Math.min(W, H) / 2 / extent, cx = W / 2, cy = H / 2, P = ([x, y]) => [cx + x * s, cy - y * s];
  let b = `<rect x="0" y="0" width="${W}" height="${H}" fill="${css("--soft")}" rx="10"/>`;
  shapes.forEach(sh => {
    if (sh[0] === "rect") { const [ax, ay] = P(sh[1]), [bx, by] = P(sh[2]); b += `<rect x="${Math.min(ax, bx)}" y="${Math.min(ay, by)}" width="${Math.abs(bx - ax)}" height="${Math.abs(by - ay)}" fill="${css("--accent-soft")}" stroke="${css("--accent")}" stroke-dasharray="5 3"><title>zone de recherche des transactions</title></rect>`; }
    else b += `<circle cx="${cx}" cy="${cy}" r="${sh[1] * s}" fill="none" stroke="${css("--c2")}" stroke-width="2"><title>rayon des DPE voisins</title></circle>`;
  });
  tx.forEach(t => { const [x, y] = P(toM(t.lon, t.lat)); b += `<circle cx="${x}" cy="${y}" r="5" fill="${css("--c1")}" fill-opacity=".55"><title>${esc(FORMATS.date(t.date))} : ${esc(FORMATS.sqm(t.price_per_sqm))}</title></circle>`; });
  b += `<circle cx="${cx}" cy="${cy}" r="6" fill="${css("--nogo")}"><title>point de référence</title></circle>`;
  const bar = 200 * s; b += `<line x1="12" x2="${12 + bar}" y1="${H - 12}" y2="${H - 12}" stroke="${css("--ink")}" stroke-width="2"/>` + T(12 + bar / 2, H - 18, "200 m", "tick", "middle") + T(W - 10, 16, "N ↑", "tick", "end");
  return svg(W, H, b, "schéma de la zone d'étude") + `<div class="legend"><span><i style="background:${css("--nogo")};border-radius:50%"></i>actif</span><span><i style="background:${css("--accent-soft")};border:1px dashed ${css("--accent")}"></i>zone des transactions</span><span><i style="border:2px solid ${css("--c2")};border-radius:50%"></i>rayon des DPE</span></div>`;
}

// ================================================================== Q1 Prix
