    const lo = Math.min(...ms) * 0.9, hi = Math.max(...ms) * 1.05, X = i => L + 36 + i / (byYear.length - 1) * (R - L - 36), Y = v => B - (v - lo) / (hi - lo) * (B - Tp);
    let b = "";
