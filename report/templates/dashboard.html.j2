  document.querySelectorAll("#sensibilites-body [data-m]").forEach(b => b.addEventListener("click", () => { tornadoMetric = b.dataset.m; document.querySelectorAll("#sensibilites-body [data-m]").forEach(x => x.setAttribute("aria-pressed", x === b)); safe(drawTornado, "tornado"); }));
