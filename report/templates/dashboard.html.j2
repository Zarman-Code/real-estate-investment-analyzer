      <span class="ico" aria-hidden="true">${(CAT[r.category] || ["", "•"])[1]}</span><span class="name">${esc(r.title)}</span>
      <span><span class="badge lv-${esc(r.level)}">${esc(r.level)}</span> <span class="small muted">${esc((CAT[r.category] || [r.category])[0])}</span></span>
      <span class="score">P ${fmt("risks." + r.id + ".probability", { format: "int" })} × I ${fmt("risks." + r.id + ".impact", { format: "int" })} = ${fmt("risks." + r.id + ".criticality", { format: "crit" })}</span></a>`).join("")}</div>` : ""}`;
  document.querySelectorAll("#verdict-body [data-risk]").forEach(a => a.addEventListener("click", () => selectRisk(a.dataset.risk, true)));
