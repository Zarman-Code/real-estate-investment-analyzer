  const takeup = card("Demande placée (m², par trimestre)", "market.take_up", ser("market.take_up"), "int", `<p class="small">Dernier trimestre ${fmt("market.take_up", { format: "m2" })}, ${fmt("market.take_up", { field: "yoy", format: "pct", signed: true })} sur un an.</p>`);
