  const verb = REC.decision === "NO_GO" ? "expliquent le plus le NO-GO" : "pèsent le plus sur la marge";
  const drivers = top.length === 2 ? `Les deux hypothèses qui ${verb} : « ${lbl(top[0].label)} » (${rng(top[0])} de marge) et « ${lbl(top[1].label)} » (${rng(top[1])}).` : "";
