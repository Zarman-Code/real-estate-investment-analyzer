        b += `<text x="${L + i * cw + (cw - 2) / 2}" y="${Tp + j * ch + ch / 2 + 4}" class="val" data-key="${esc(key)}" text-anchor="middle" style="font-size:11px;font-weight:${isNum(v) && v >= tgt ? 700 : 500};fill:${ink}">${esc((isNum(v) && v >= tgt ? "✓" : "") + (isNum(v) ? txt.replace(" %", "") : "–"))}</text>`;
