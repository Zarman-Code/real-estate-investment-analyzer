<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
/* ================================================================== système de design (aucune donnée du deal) */
:root {
  --bg: #f4f3ef; --panel: #ffffff; --ink: #1b1f24; --muted: #525b65; --faint: #8a939c; --line: #dedbd4; --soft: #efede8; --soft2: #f8f7f4;
  --accent: #27537c; --accent-soft: #e3ebf3;
  --go: #1d6a43; --go-soft: #e1f1e7; --cond: #87540b; --cond-soft: #f8ecd5; --nogo: #9e2f2f; --nogo-soft: #f7e1df;
  --undet: #525b65; --undet-soft: #e9ecef;
  --pos: #2b7a4f; --neg: #ad3636;
  --lvl-faible: #3d7851; --lvl-modere: #85660b; --lvl-eleve: #a3531e; --lvl-critique: #9e2f2f; --lvl-incertain: #5d6671;
  --c1: #27537c; --c2: #b98419; --c3: #7c8691; --c4: #a3b7cb;
  --dot: #8a939c;
  --s1: 8px; --s2: 16px; --s3: 24px; --s4: 32px;
  --r1: 12px; --r2: 16px;
  --shadow: 0 1px 2px rgba(20, 24, 30, .06), 0 2px 8px rgba(20, 24, 30, .05);
  --bar-h: 48px;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
html { scroll-padding-top: calc(var(--bar-h) + 12px); }
body { margin: 0; background: var(--bg); color: var(--ink); font-size: 16px; line-height: 1.5; padding-bottom: 44px; }
a { color: var(--accent); }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.v, .num, table, .tile, svg text { font-variant-numeric: tabular-nums; }
.prose, .message, .synth, .drivers { max-width: 70ch; }

/* A1. barre du haut : une ligne fine, collante */
.topbar { position: sticky; top: 0; z-index: 30; height: var(--bar-h); background: rgba(255,255,255,.97); border-bottom: 1px solid var(--line); }
.topbar-inner { max-width: 1280px; height: 100%; margin: 0 auto; padding: 0 var(--s3); display: flex; align-items: center; gap: 12px; }
.brand { font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.brand-date { color: var(--muted); font-size: 14px; white-space: nowrap; }
nav.anchors { margin-left: auto; display: flex; gap: 4px; }
nav.anchors a { color: var(--muted); text-decoration: none; font-size: 14px; padding: 6px 10px; border-radius: 8px; white-space: nowrap; }
nav.anchors a:hover, nav.anchors a:focus-visible { color: var(--ink); background: var(--soft); }
nav.anchors a[aria-current="true"] { color: var(--accent); background: var(--accent-soft); font-weight: 600; }
/* A2. bandeau des valeurs modifiées : sous la barre, masqué tant qu'aucun curseur n'a bougé */
.modified-banner { position: sticky; top: var(--bar-h); z-index: 25; background: var(--cond-soft); color: var(--cond); border-bottom: 1px solid #e3c896;
  padding: 6px var(--s3); font-size: 14px; font-weight: 600; text-align: center; }
.modified-banner button { margin-left: var(--s1); }
main { max-width: 1280px; margin: 0 auto; padding: var(--s2) var(--s3) var(--s4); }
.toolbar { display: flex; justify-content: flex-end; margin-bottom: var(--s1); }
section.block { scroll-margin-top: calc(var(--bar-h) + 16px); background: var(--panel); border: 1px solid var(--line); border-radius: var(--r2);
  box-shadow: var(--shadow); padding: var(--s3); margin: 0 0 var(--s3); }
section.block > h2 { margin: 0 0 var(--s1); font-size: 21px; }
section.compact { padding: var(--s1) var(--s2); }
section.compact details.fold { margin: 0; border: 0; background: none; }
.qtag { display: inline-block; font-size: 12px; font-weight: 700; color: var(--accent); background: var(--accent-soft); border-radius: 6px; padding: 1px 7px; margin-right: 8px; vertical-align: 3px; }
.message { font-size: 17px; margin: 0 0 var(--s2); }
h3 { font-size: 16px; margin: var(--s3) 0 var(--s1); }
.grid { display: grid; gap: var(--s2); }
.g2 { grid-template-columns: repeat(auto-fit, minmax(440px, 1fr)); }
.g3 { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
.grid > *, .cols2 > *, .sim > *, .risk-layout > *, .verdict-grid > * { min-width: 0; }
.card { border: 1px solid var(--line); border-radius: var(--r1); padding: var(--s2); background: var(--panel); position: relative; }
.card h3 { margin-top: 0; }
.muted { color: var(--muted); }
.small { font-size: 14px; }
.section-error { background: var(--cond-soft); border-left: 3px solid var(--cond); padding: 8px 12px; border-radius: 8px; font-size: 14px; }
.box { border-radius: var(--r1); padding: 12px var(--s2); font-size: 15px; margin: var(--s2) 0; }
.box h4 { margin: 0 0 4px; font-size: 15px; }
.box.limits { background: var(--soft2); border: 1px solid var(--line); }
.box.hyp { background: #fdf4e7; border: 1px solid #ecd3a9; }
.box.warn { background: var(--cond-soft); border-left: 4px solid var(--cond); }
.box.keymiss { background: #fdf4e7; border: 1px solid #e3c896; border-left: 4px solid var(--cond); margin-top: 0; }
.box.keymiss h4::before { content: "⚠ "; }
.box.na { background: var(--soft2); border: 1px dashed var(--line); color: var(--muted); }
table { border-collapse: collapse; width: 100%; font-size: 15px; }
th, td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--soft); vertical-align: top; }
th { color: var(--muted); font-weight: 600; font-size: 14px; }
td.r, th.r { text-align: right; }
.neg, .neg .num { color: var(--neg); }
button.btn { border: 1px solid var(--line); background: var(--panel); border-radius: 10px; padding: 7px 14px; cursor: pointer; font: inherit; font-size: 14px; color: var(--ink); }
button.btn:hover { background: var(--soft); }
button.btn:focus-visible, summary:focus-visible, .chip:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

/* A3. blocs repliables : ligne-résumé avec chiffre clé */
details.fold { border: 1px solid var(--line); border-radius: var(--r1); margin: var(--s2) 0; background: var(--soft2); }
details.fold > summary { cursor: pointer; list-style: none; padding: 12px var(--s2); display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; }
details.fold > summary::-webkit-details-marker { display: none; }
details.fold > summary::before { content: "▸"; color: var(--muted); width: 12px; }
details.fold[open] > summary::before { content: "▾"; }
details.fold > summary .sum-title { font-weight: 600; }
details.fold > summary .sum-key { color: var(--muted); font-size: 14px; }
details.fold > .fold-body { padding: var(--s1) var(--s2) var(--s2); background: var(--panel); border-top: 1px solid var(--line); border-radius: 0 0 var(--r1) var(--r1); }

/* D. valeurs, pastilles, légende */
.v .num { white-space: nowrap; }
.v.is-text .num { white-space: normal; }
.v.is-hyp .num { font-style: italic; }
.v.is-low { outline: 1.5px dashed var(--faint); outline-offset: 2px; border-radius: 4px; }
.v.is-na .num { color: var(--muted); font-style: normal; }
.v.is-sim .num { color: var(--cond); }
.v.neg .num { color: var(--neg); }               /* écart négatif en rouge, toujours avec son signe */
.pill { position: relative; display: inline-flex; align-items: center; justify-content: center; border: 0; background: none; padding: 0; margin-left: 3px;
  cursor: pointer; color: var(--dot); font: 12px/1 system-ui, sans-serif; vertical-align: 1px; }
.pill.dot { width: 12px; height: 12px; font-size: 10px; }
.pill.word { font-size: 11.5px; color: var(--muted); margin-left: 6px; font-weight: 400; font-style: normal; }
.pill.dot:hover::after, .pill.dot:focus-visible::after { content: attr(data-word); position: absolute; bottom: 140%; left: 50%; transform: translateX(-50%);
  background: var(--ink); color: #fff; font-size: 11.5px; padding: 2px 6px; border-radius: 6px; white-space: nowrap; z-index: 5; pointer-events: none; font-weight: 400; }
.pill:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; border-radius: 4px; }
.corner-pill { position: absolute; top: 8px; right: 10px; }
.caption { font-size: 13px; color: var(--muted); margin-top: 6px; }
.caption .src-name { border: 0; background: none; padding: 0; font: inherit; color: var(--muted); text-decoration: underline dotted; text-underline-offset: 3px; cursor: pointer; }
.caption .src-name:hover, .caption .src-name:focus-visible { color: var(--ink); }
.legend-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 20; background: rgba(255,255,255,.97); border-top: 1px solid var(--line);
  font-size: 13px; color: var(--muted); padding: 6px var(--s3); display: flex; gap: var(--s2); justify-content: center; flex-wrap: wrap; }
.legend-bar .sym { color: var(--dot); margin-right: 4px; }
#src-popover { position: absolute; z-index: 50; width: max-content; max-width: min(420px, calc(100vw - 16px)); background: var(--panel);
  border: 1px solid var(--line); border-radius: var(--r1); box-shadow: 0 8px 24px rgba(0,0,0,.14); padding: 12px 14px; font-size: 14px; }
#src-popover h4 { margin: 0 22px 6px 0; font-size: 14px; }
#src-popover dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 3px 10px; }
#src-popover dt { color: var(--muted); }
#src-popover dd { margin: 0; overflow-wrap: anywhere; }
#src-popover ul { margin: 6px 0 0; padding-left: 18px; }
#src-popover .close { position: absolute; top: 4px; right: 8px; border: 0; background: none; font-size: 20px; cursor: pointer; color: var(--muted); }
abbr.term { text-decoration: underline dotted; text-underline-offset: 3px; cursor: help; }

/* graphiques SVG */
svg { display: block; width: 100%; height: auto; overflow: visible; }
svg text { font-family: inherit; fill: var(--ink); font-size: 13px; }
svg .tick, svg .lab { fill: var(--muted); font-size: 12.5px; }
svg .val { font-weight: 600; }
svg .axis { stroke: var(--line); }
svg .gridl { stroke: var(--soft); }
.legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 13.5px; color: var(--muted); margin: 6px 0; }
.legend i { display: inline-block; width: 12px; height: 12px; border-radius: 3px; margin-right: 5px; vertical-align: -1px; }
.seg { display: inline-flex; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; font-size: 14px; vertical-align: middle; margin-left: 8px; }
.seg button { border: 0; background: var(--panel); padding: 4px 11px; cursor: pointer; color: var(--muted); font: inherit; }
.seg button[aria-pressed="true"] { background: var(--accent); color: #fff; }
.clickable { cursor: pointer; }

/* C. verdict */
.verdict-grid { display: grid; grid-template-columns: minmax(250px, 1fr) 2.3fr; gap: var(--s3); align-items: start; }
.decision { border-radius: var(--r2); padding: var(--s3); display: flex; gap: 14px; align-items: flex-start; }
.decision .icon { font-size: 30px; line-height: 1; font-weight: 800; }
.decision .kicker { font-size: 13px; text-transform: uppercase; letter-spacing: .07em; }
.decision .label { font-size: 40px; font-weight: 800; line-height: 1.05; margin: 2px 0 4px; overflow-wrap: anywhere; }
.decision .label.long { font-size: 30px; }
.decision .sub { font-size: 14px; color: var(--ink); }
.decision .margin { margin-top: 12px; color: var(--ink); font-size: 14px; }
.decision .margin .num { font-size: 24px; font-weight: 700; }
.d-GO { background: var(--go-soft); color: var(--go); }
.d-GO_SOUS_CONDITIONS { background: var(--cond-soft); color: var(--cond); }
.d-GO_AVEC_CONTRAINTES { background: var(--go-soft); color: var(--go); }
.d-NO_GO { background: var(--nogo-soft); color: var(--nogo); }
.d-NON_DETERMINE { background: var(--undet-soft); color: var(--undet); }
.bigcards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.bigcard { border: 1px solid var(--line); border-radius: var(--r1); padding: 12px var(--s2); position: relative; }
.bigcard .k { font-size: 14px; color: var(--muted); padding-right: 64px; }
.bigcard .val { font-size: 27px; font-weight: 700; margin-top: 2px; }
.pricebar { margin-top: var(--s2); }
.synth { margin: var(--s2) 0 4px; }
.drivers { margin: 4px 0 8px; color: var(--muted); font-size: 15px; }
.riskcards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: var(--s2); }
.riskcard { border: 1px solid var(--line); border-radius: var(--r1); padding: 12px 14px; display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; align-items: start; text-decoration: none; color: var(--ink); background: var(--panel); }
.riskcard:hover { box-shadow: var(--shadow); }
.riskcard .ico { grid-row: span 3; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--soft); font-size: 18px; color: var(--muted); }
.riskcard .name { font-weight: 600; line-height: 1.3; }
.badge { display: inline-block; font-size: 12.5px; font-weight: 700; padding: 1px 8px; border-radius: 999px; border: 1px solid currentColor; }
.riskcard .score { font-size: 14px; color: var(--muted); }
.lv-faible { color: var(--lvl-faible); } .lv-modéré { color: var(--lvl-modere); } .lv-élevé { color: var(--lvl-eleve); }
.lv-critique { color: var(--lvl-critique); } .lv-incertain { color: var(--lvl-incertain); }
.dot-lv { width: 10px; height: 10px; border-radius: 50%; display: inline-block; background: currentColor; flex: none; }

/* B. note go/no-go */
.note-box { border-left: 4px solid var(--accent); background: var(--soft2); border-radius: 0 var(--r1) var(--r1) 0; padding: 12px var(--s2); }
.note-box p { margin: 6px 0; max-width: 95ch; }
.note-actions { display: flex; gap: var(--s1); align-items: center; margin: 12px 0 0; }
.copied { color: var(--go); font-size: 14px; }
.explanation { margin-top: var(--s3); }
.explanation .expl-title { margin: 0 0 var(--s1); font-size: 17px; }
.expl-sec { border-top: 1px solid var(--line); padding-top: 12px; margin-top: 12px; }
.expl-sec h4 { margin: 0 0 6px; font-size: 15px; color: var(--accent); }
.expl-sec .prose { max-width: 95ch; margin: 0 0 6px; }
.expl-sec ul.args li { max-width: 95ch; }

/* tuiles, simulateur, risques */
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; }
.tile { border: 1px solid var(--line); border-radius: var(--r1); padding: 12px 14px; background: var(--panel); }
.tile .k { font-size: 14px; color: var(--muted); }
.tile .val { font-size: 22px; font-weight: 700; margin: 2px 0; }
.tile .val.sm { font-size: 19px; }
.tile .t { font-size: 13.5px; }
.ok { color: var(--pos); } .ko { color: var(--neg); }
.status-ok::before { content: "✓ "; } .status-ko::before { content: "✗ "; }
.minis { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: var(--s2); margin-top: var(--s2); }
.minis svg { max-width: 460px; }
.sim { display: grid; grid-template-columns: minmax(300px, 1fr) minmax(340px, 1.1fr); gap: var(--s3); }
.slider { margin: 8px 0 14px; }
.slider label { display: flex; justify-content: space-between; gap: 8px; font-size: 15px; }
.slider input { width: 100%; accent-color: var(--accent); }
.slider .range { display: flex; justify-content: space-between; font-size: 12.5px; color: var(--muted); }
.slider.changed label > span:first-child::after { content: " (modifié)"; color: var(--cond); font-size: 13px; }
.risk-layout { display: grid; grid-template-columns: minmax(340px, 1fr) minmax(320px, 1.2fr); gap: var(--s3); }
.chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0; }
.chip { border: 1px solid var(--line); border-radius: 999px; padding: 3px 11px; font-size: 14px; cursor: pointer; background: var(--panel); font-family: inherit; color: var(--ink); }
.chip[aria-pressed="true"] { border-color: var(--ink); background: var(--soft); }
.risk-list { list-style: none; padding: 0; margin: 8px 0; }
.risk-list li { border-bottom: 1px solid var(--soft); display: flex; align-items: center; gap: 8px; }
.risk-list > li > button { flex: 1; text-align: left; background: none; border: 0; padding: 7px 4px; cursor: pointer; font: inherit; display: flex; gap: 8px; align-items: center; color: var(--ink); }
.risk-list > li > button[aria-current="true"] { background: var(--soft); border-radius: 8px; }
.risk-list .crit { color: var(--muted); font-size: 14px; white-space: nowrap; }
.uncertain-box { border: 1px dashed var(--lvl-incertain); border-radius: var(--r1); padding: 8px 12px; font-size: 14px; margin-top: 8px; }
.scards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
.scard { border: 1px solid var(--line); border-radius: var(--r1); padding: 12px 14px; }
.scard h3 { margin: 0 0 8px; display: flex; justify-content: space-between; align-items: baseline; gap: 8px; flex-wrap: wrap; }
.scard .verdict-ico { font-size: 13px; font-weight: 700; }
.scard dl { margin: 0; display: grid; grid-template-columns: 1fr auto; gap: 4px 8px; font-size: 15px; }
.scard dt { color: var(--muted); }
.scard dd { margin: 0; text-align: right; font-weight: 600; }
.cols2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s3); }
ul.args { padding-left: 20px; margin: 6px 0; }
ul.args li { margin: 5px 0; max-width: 80ch; }
.filters { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 8px 0; }
.filters input[type=search] { font: inherit; padding: 5px 9px; border: 1px solid var(--line); border-radius: 8px; min-width: 220px; }
.opstrip { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
.map-inset { max-width: 260px; }
footer { max-width: 1280px; margin: 0 auto; padding: 0 var(--s3) var(--s4); color: var(--muted); font-size: 13.5px; }

@media (max-width: 900px) {
  .verdict-grid, .sim, .risk-layout, .cols2, .g2 { grid-template-columns: 1fr; }
  .bigcards, .riskcards { grid-template-columns: 1fr; }
  .decision .label { font-size: 32px; }
  .brand-date { display: none; }
  nav.anchors a { padding: 6px 6px; font-size: 13px; }
  .topbar-inner, main { padding-left: var(--s2); padding-right: var(--s2); }
  section.block { padding: var(--s2); }
  .v .num { white-space: normal; }
  td, th { overflow-wrap: anywhere; padding: 6px 4px; }
  table { font-size: 14px; }
}
@media (max-width: 560px) { nav.anchors a:not([aria-current="true"]) { display: none; } .brand { max-width: 50vw; } }
@media print {
  body { background: #fff; padding: 0; font-size: 11pt; }
  .topbar, .legend-bar, .toolbar, .modified-banner, .seg, button.btn, .note-actions, nav.anchors { display: none !important; }
  .expl-sec { break-inside: avoid-page; }
  section.block { break-before: page; border: 0; box-shadow: none; padding: 0; margin: 0 0 12pt; }
  #verdict, section.compact { break-before: auto; }
  #note .note-box { border-left: 2px solid #000; background: none; padding-left: 10pt; }
  #note .note-box p { max-width: none; }
  .pill { display: none !important; }
  details.fold { border: 0; background: none; }
  a { color: inherit; text-decoration: none; }
}
</style>
</head>
<body>
<header class="topbar"><div class="topbar-inner">
  <span class="brand" id="brand"></span><span class="brand-date" id="brand-date"></span>
  <nav class="anchors" aria-label="Sections">
    <a href="#verdict" data-group="verdict">Verdict</a><a href="#prix" data-group="marche">Marché</a><a href="#cout" data-group="rentabilite">Rentabilité</a><a href="#risques" data-group="risques">Risques</a><a href="#annexes" data-group="annexes">Annexes</a>
  </nav>
</div></header>
<div class="modified-banner" id="modified-banner" role="status" hidden>Valeurs modifiées par l'utilisateur dans le simulateur : ces résultats ne sont pas la recommandation officielle.
  <button type="button" class="btn" id="modified-reset">Revenir au scénario central</button></div>

<main>
  <div class="toolbar"><button type="button" class="btn" id="toggle-all" aria-pressed="false">Tout déplier</button></div>
  <section class="block" id="verdict" data-group="verdict" aria-labelledby="h-verdict"><h2 id="h-verdict" class="sr-only">Décision</h2><div id="verdict-body"></div></section>
  <section class="block" id="note" data-group="verdict" aria-labelledby="h-note"><h2 id="h-note">Note go/no-go</h2><div id="note-body"></div></section>
  <section class="block compact" id="operation" data-group="verdict" aria-label="L'opération en un coup d'œil"><div id="operation-body"></div></section>
  <section class="block" id="prix" data-group="marche" aria-labelledby="h-prix"><h2 id="h-prix"><span class="qtag">Q1</span>Prix : cohérence avec les transactions du quartier</h2><div id="prix-body"></div></section>
  <section class="block" id="loyer" data-group="marche" aria-labelledby="h-loyer"><h2 id="h-loyer"><span class="qtag">Q2</span>Loyer espéré après restructuration</h2><div id="loyer-body"></div></section>
  <section class="block compact" id="marche" data-group="marche" aria-label="Contexte de marché"><div id="marche-body"></div></section>
  <section class="block" id="cout" data-group="rentabilite" aria-labelledby="h-cout"><h2 id="h-cout"><span class="qtag">Q3</span>Coût total et valeur de sortie</h2><div id="cout-body"></div></section>
  <section class="block" id="rentabilite" data-group="rentabilite" aria-labelledby="h-rent"><h2 id="h-rent"><span class="qtag">Q4</span>Rentabilité face aux taux et aux objectifs</h2><div id="rentabilite-body"></div></section>
  <section class="block" id="sensibilites" data-group="rentabilite" aria-labelledby="h-sens"><h2 id="h-sens"><span class="qtag">Q5</span>Ce qui fait basculer la décision</h2><div id="sensibilites-body"></div></section>
  <section class="block" id="scenarios" data-group="rentabilite" aria-labelledby="h-scen"><h2 id="h-scen">Scénarios : plusieurs hypothèses ensemble</h2><div id="scenarios-body"></div></section>
  <section class="block" id="risques" data-group="risques" aria-labelledby="h-risques"><h2 id="h-risques"><span class="qtag">Q6</span>Principaux risques</h2><div id="risques-body"></div></section>
  <section class="block" id="annexes" data-group="annexes" aria-labelledby="h-annexes"><h2 id="h-annexes">Annexes</h2><div id="annexes-body"></div></section>
</main>
<footer id="footer"></footer>
<div class="legend-bar" aria-label="Légende des pastilles"><span><span class="sym" aria-hidden="true">■</span>Saisi</span><span><span class="sym" aria-hidden="true">◆</span>Calculé</span><span><span class="sym" aria-hidden="true">▲</span>Hypothèse</span><span><span class="sym" aria-hidden="true">●</span>Source</span><span>· cliquer une pastille ou une source pour le détail</span></div>
<div id="src-popover" role="dialog" aria-label="Fiche de la source" hidden></div>

<script>window.DATA = {{ data_json }};</script>
<script>{{ engine_js }}</script>
<script>
{% raw %}
"use strict";
const D = window.DATA, E = window.HeliosEngine;
const $ = id => document.getElementById(id);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
const isNum = v => typeof v === "number" && Number.isFinite(v);
const css = v => getComputedStyle(document.documentElement).getPropertyValue(v).trim();

// ================================================================== formats (français), sans aucune valeur du deal
const nf = (v, d = 0) => v.toLocaleString("fr-FR", { minimumFractionDigits: d, maximumFractionDigits: d });
const sign = v => (v > 0 ? "+" : "");
const FORMATS = {
  meur: v => nf(v / 1e6, 1) + " M€", meur2: v => nf(v / 1e6, 2) + " M€", meur_abs: v => nf(Math.abs(v) / 1e6, 1) + " M€", eur: v => nf(v, 0) + " €",
  pct: v => nf(v * 100, 1) + " %", pct0: v => nf(v * 100, 0) + " %", pct2: v => nf(v * 100, 2) + " %",
  pct_abs: v => nf(Math.abs(v) * 100, 1) + " %", pct100: v => nf(v, 1) + " %", pct_signed: v => sign(v) + nf(v * 100, 1) + " %",
  bps: v => nf(v, 0) + " pb", bps_signed: v => sign(v) + nf(v, 0) + " pb", pts: v => sign(v) + nf(v, 1) + " pt",
  sqm: v => nf(v, 0) + " €/m²", rent: v => nf(v, 0) + " €/m²/an", m2: v => nf(v, 0) + " m²",
  int: v => nf(v, 0), dec: v => nf(v, 2), dec1: v => nf(v, 1), mult: v => nf(v, 2) + "x", months: v => nf(v, Number.isInteger(v) ? 0 : 1) + " mois",
  months_signed: v => sign(v) + nf(v, 0) + " mois", crit: v => nf(v, 0) + "/25", prob: v => nf(v, 0) + "/5", year: v => String(v), raw: v => String(v),
  date: v => { const p = String(v).slice(0, 10).split("-"); return p.length === 3 ? `${p[2]}/${p[1]}/${p[0]}` : String(v); },
};
const UNIT_FORMAT = { "€": "meur", "€/m²": "sqm", "€/m²/an": "rent", "fraction": "pct", "%": "pct100", "bps": "bps",
                      "m²": "m2", "mois": "months", "x": "mult", "pts": "pts" };
const NO_NEG = ["meur_abs", "pct_abs", "raw", "year", "date"];
const METHOD_LABEL = { api: "API publique", report_extraction: "extraction d'un rapport", computed: "calculé par le moteur",
                       assumption: "hypothèse", user_input: "saisi (dossier de l'opération)", none: "aucune source n'a répondu", sim: "simulateur" };
const STATUS_LABEL = { ok: "donnée valide", partial: "donnée partielle", missing: "donnée manquante", assumption: "hypothèse",
                       rejected: "donnée écartée par les contrôles" };
const CONF_LABEL = { high: "élevée", medium: "moyenne", low: "faible" };
const FMT_MISSING = new Map();      // clé -> raison des valeurs affichées « non disponible »

const dpOf = key => D.datapoints[key];
const labelOf = key => (dpOf(key) && dpOf(key).label) || key;
function pathOf(field) { return field === undefined || field === null ? [] : Array.isArray(field) ? field : String(field).split("."); }
// valeur brute (pour dessiner ou comparer) : jamais affichée sans passer par fmt ou fig.n
function val(key, field) {
  const dp = dpOf(key); if (!dp || dp.status === "missing" || dp.status === "rejected") return null;
  let v = dp.value;
  for (const p of pathOf(field)) v = (v === null || v === undefined) ? undefined : v[p];
  if (!field && v !== null && typeof v === "object" && !Array.isArray(v)) { const f = ["last", "median", "value"].find(k => k in v); v = f ? v[f] : v; }
  return v === undefined ? null : v;
}
const wrapDate = s => `<span class="date">${esc(s)}</span>`;
const lbl = s => `<span class="lbl">${esc(s)}</span>`;

// ================================================================== D9-D10. pastilles
const KIND = {
  na: { cls: "pill-na", sym: "○", word: "Non disponible" }, sim: { cls: "pill-sim", sym: "✱", word: "Simulé" },
  hyp: { cls: "pill-hyp", sym: "▲", word: "Hypothèse" }, user: { cls: "pill-user", sym: "■", word: "Saisi" },
  calc: { cls: "pill-calc", sym: "◆", word: "Calculé" }, src: { cls: "pill-src", sym: "●", word: "Source" },
};
function kindOf(dp) {
  if (!dp || dp.status === "missing" || dp.status === "rejected") return KIND.na;
  if (dp.method === "sim") return KIND.sim;
  if (dp.method === "assumption" || dp.status === "assumption") return KIND.hyp;
  if (dp.method === "user_input") return KIND.user;
  if (dp.method === "computed") return KIND.calc;
  return KIND.src;
}
function hoverText(key) {
  const dp = dpOf(key);
  return !dp ? "clé absente des données" : dp.method === "computed" ? `${dp.label || key} — calcul : ${dp.notes || ""}`
    : `${dp.label || key} — ${dp.source_name}${dp.data_date ? ", donnée du " + dp.data_date : ""}`;
}
// mode : "dot" (point discret, mot au survol / focus), "word" (mot court en clair), "corner" (une pastille en coin de carte)
function pill(key, mode = "dot") {
  const k = kindOf(dpOf(key)), h = hoverText(key), word = mode !== "dot";
  const cls = `pill ${k.cls} ${word ? "word" : "dot"}${mode === "corner" ? " corner-pill" : ""}`;
  return `<button type="button" class="${cls}" data-key="${esc(key)}" data-word="${esc(k.word)}" title="${esc(k.word + " — " + h)}" aria-label="${esc(k.word + " : " + h)}">${word ? esc(k.word) : k.sym}</button>`;
}

/* Fonction UNIQUE d'affichage d'un chiffre (spécification, 4.3) : lit DATA.datapoints[key], formate, ajoute la pastille.
   options : field, format, signed, show ("notes"), pill ("dot" | "word" | "none" : la carte porte alors sa pastille en coin). */
function fmt(key, options = {}) {
  const dp = dpOf(key), mode = options.pill || "dot";
  const p = mode === "none" ? "" : pill(key, mode);
  if (options.show === "notes") {
    if (!dp || !dp.notes) return `<span class="v is-na"><span class="num">— non disponible</span>${p}</span>`;
    return `<span class="v is-text"><span class="num">${esc(dp.notes)}</span>${p}</span>`;
  }
  let v = dp ? dp.value : undefined;
  if (dp) for (const q of pathOf(options.field)) v = (v === null || v === undefined) ? undefined : v[q];
  if (dp && !options.field && v !== null && typeof v === "object" && !Array.isArray(v)) { const f = ["last", "median", "value"].find(k => k in v); v = f ? v[f] : undefined; }
  if (!dp || dp.status === "missing" || dp.status === "rejected" || v === null || v === undefined || typeof v === "object") {
    const why = !dp ? "clé absente des données" : dp.status === "rejected" ? "donnée écartée par les contrôles" : (dp.notes || "valeur non disponible");
    FMT_MISSING.set(key + (options.field ? ":" + pathOf(options.field).join(".") : ""), { label: labelOf(key), why });
    return `<span class="v is-na"><span class="num">— non disponible</span>${p}</span>`;
  }
  const txt = fmtValue(dp, v, options), kind = kindOf(dp);
  const neg = isNum(v) && v < 0 && !NO_NEG.includes(options.format) ? "neg" : "";
  const cls = ["v", kind === KIND.hyp ? "is-hyp" : "", kind === KIND.sim ? "is-sim" : "", dp.confidence === "low" ? "is-low" : "", !isNum(v) && String(v).length > 24 ? "is-text" : "", neg].filter(Boolean).join(" ");
  const full = isNum(v) && (options.format || UNIT_FORMAT[dp.unit]) === "meur" ? ` title="${esc(nf(v, 0) + " €")}"` : "";
  return `<span class="${cls}"><span class="num"${full}>${esc(txt)}</span>${p}</span>`;
}
function fmtValue(dp, v, options = {}) {
  if (isNum(v)) {
    const f = FORMATS[options.format || UNIT_FORMAT[dp.unit] || (Number.isInteger(v) ? "int" : "dec")] || FORMATS.dec;
    return (options.signed && v > 0 ? "+" : "") + f(v);
  }
  return (options.format === "date" || /^\d{4}-\d{2}-\d{2}$/.test(String(v))) ? FORMATS.date(v) : String(v);
}
// texte brut (copie de la note) : même formatage, sans pastille
function fmtPlain(key, options = {}) {
  const dp = dpOf(key); let v = dp ? dp.value : undefined;
  if (dp) for (const q of pathOf(options.field)) v = (v === null || v === undefined) ? undefined : v[q];
  if (dp && !options.field && v !== null && typeof v === "object" && !Array.isArray(v)) { const f = ["last", "median", "value"].find(k => k in v); v = f ? v[f] : undefined; }
  if (!dp || dp.status === "missing" || dp.status === "rejected" || v === null || v === undefined || typeof v === "object") return "non disponible";
  return fmtValue(dp, v, options);
}
const TOKEN_RE = /\{([a-zA-Z0-9_.@#-]+)(?::([a-zA-Z0-9_.]+))?(?:\|([a-z_0-9]+))?\}/g;
function fmtText(template, mode = "dot") {
  let out = "", last = 0;
  for (const m of String(template).matchAll(TOKEN_RE)) {
    out += esc(template.slice(last, m.index)) + fmt(m[1], { field: m[2], format: m[3], pill: mode });
    last = m.index + m[0].length;
  }
  return out + esc(String(template).slice(last));
}
const textPlain = template => String(template).replace(TOKEN_RE, (_, k, f, fo) => fmtPlain(k, { field: f, format: fo }));

// graphique : chaque valeur affichée est rattachée à une donnée ; la légende donne « Sources : A, B, C » (D11)
function Fig() {
  const keys = new Set();
  return {
    n(key, value, format) { keys.add(key); if (!isNum(value)) return "n.d."; return (FORMATS[format] || FORMATS.dec)(value); },
    use(key) { keys.add(key); },
    caption(prefix = "") { return keys.size ? `<div class="caption">${prefix}${srcLine([...keys])}</div>` : (prefix ? `<div class="caption">${prefix}</div>` : ""); },
  };
}
function srcName(key) {
  const dp = dpOf(key); if (!dp) return "donnée absente";
  if (dp.method === "computed") return "calcul du modèle";
  if (dp.method === "assumption" || dp.status === "assumption") return "hypothèses du modèle";
  if (dp.method === "user_input") return "dossier de l'opération";
  if (dp.method === "sim") return "simulateur";
  return dp.source_name.split(" - ")[0].split(" (")[0];
}
function srcLine(keys) {
  const groups = new Map();
  keys.forEach(k => { const n = srcName(k); if (!groups.has(n)) groups.set(n, []); groups.get(n).push(k); });
  return "Sources : " + [...groups].map(([n, ks]) => {
    const dp = dpOf(ks[0]), tip = dp ? [dp.data_date ? "donnée du " + dp.data_date : "", METHOD_LABEL[dp.method] || dp.method, "confiance " + (CONF_LABEL[dp.confidence] || dp.confidence)].filter(Boolean).join(" · ") : "";
    return `<button type="button" class="src-name" data-keys="${esc(ks.join(" "))}" title="${esc(tip)}">${lbl(n)}</button>`;
  }).join(", ");
}

// ================================================================== fiche source (survol : title ; clic ou Entrée : fiche)
function cardRows(key) {
  const dp = dpOf(key), file = dp && dp.source_url && /\.(xlsx?|csv|pdf|zip)(\?|$)/i.test(dp.source_url);
  return dp ? [
    ["Donnée", esc(dp.label || key)], ["Source", esc(dp.source_name)], ["Date de la donnée", esc(dp.data_date || "non précisée")],
    ["Méthode", esc(METHOD_LABEL[dp.method] || dp.method)], ["Statut", esc(STATUS_LABEL[dp.status] || dp.status)],
    ["Confiance", esc(CONF_LABEL[dp.confidence] || dp.confidence)],
    file && dp.retrieved_at ? ["Fichier", `fichier téléchargé le ${esc(FORMATS.date(dp.retrieved_at))}`] : null,
    dp.notes ? [dp.method === "computed" ? "Formule" : "Notes", esc(dp.notes)] : null,
    dp.source_url ? ["Lien", `<a href="${esc(dp.source_url)}" target="_blank" rel="noopener noreferrer">${esc(dp.source_url)}</a>`] : null,
  ].filter(Boolean) : [["Statut", "absente des données"]];
}
function showPopover(btn) {
  const pop = $("src-popover");
  if (btn.classList.contains("src-name")) {
    const keys = btn.dataset.keys.split(" ");
    const rows = cardRows(keys[0]).filter(([a]) => !["Donnée", "Formule", "Notes"].includes(a));
    pop.innerHTML = `<button type="button" class="close" aria-label="Fermer">×</button><h4>${esc(btn.textContent)}</h4><dl>${rows.map(([a, b]) => `<dt>${a}</dt><dd>${b}</dd>`).join("")}</dl>
      <ul>${keys.map(k => `<li>${esc(labelOf(k))}${dpOf(k) && dpOf(k).method === "computed" && dpOf(k).notes ? " — " + esc(dpOf(k).notes) : ""}</li>`).join("")}</ul>`;
  } else {
    const dp = dpOf(btn.dataset.key);
    pop.innerHTML = `<button type="button" class="close" aria-label="Fermer">×</button><h4>${esc(kindOf(dp).word)}</h4><dl>${cardRows(btn.dataset.key).map(([a, b]) => `<dt>${a}</dt><dd>${b}</dd>`).join("")}</dl>`;
  }
  pop.hidden = false;
  const r = btn.getBoundingClientRect();
  pop.style.top = `${window.scrollY + r.bottom + 6}px`;
  pop.style.left = `${Math.max(8, Math.min(window.scrollX + r.left - 20, window.scrollX + document.documentElement.clientWidth - pop.offsetWidth - 8))}px`;
  pop.querySelector(".close").focus();
}
document.addEventListener("click", e => {
  const btn = e.target.closest(".pill, .src-name");
  if (btn) { e.preventDefault(); e.stopPropagation(); showPopover(btn); return; }
  if (e.target.closest(".close") || !e.target.closest("#src-popover")) $("src-popover").hidden = true;
}, true);
document.addEventListener("keydown", e => { if (e.key === "Escape") $("src-popover").hidden = true; });
window.addEventListener("resize", () => { $("src-popover").hidden = true; });

// ================================================================== glossaire
const GLOSSARY = {
  yoc: ["Yield on cost (YoC)", "Rendement sur coût total : revenu net stabilisé divisé par le coût total de l'opération.",
        "Ici : {financials.noi_stabilized|meur} ÷ {financials.total_cost.total|meur} = {financials.yoc_pct|pct2}."],
  noi: ["NOI", "Revenu net d'exploitation : loyers encaissés une fois l'immeuble loué, moins les charges non refacturées.",
        "Ici : {financials.noi_stabilized|meur} par an une fois stabilisé."],
  exit: ["Taux de sortie (exit yield)", "Rendement exigé par l'acquéreur final ; valeur de revente = revenu net ÷ taux de sortie. Plus le taux est bas, plus l'immeuble vaut cher.",
         "Ici : {market.yields.exit_assumed|pct2}, soit une valeur nette de sortie de {financials.exit_value|meur}."],
  spread: ["Spread", "Écart entre le yield on cost et le taux de sortie, en points de base : la création de valeur de la restructuration.",
           "Ici : {financials.spread_bps|bps} pour un objectif de {targets.min_spread_vs_exit_bps|bps}."],
  tri: ["TRI", "Taux de rendement interne : taux annuel qui annule la valeur actuelle des flux. TRI projet sans dette, TRI fonds propres avec dette.",
        "Ici : TRI projet {financials.irr_project|pct}, TRI fonds propres {financials.irr_equity|pct}."],
  multiple: ["Multiple des fonds propres", "Somme des distributions divisée par la somme des apports des fonds propres.",
             "Ici : {financials.equity_multiple|mult} pour un objectif de {targets.min_equity_multiple|mult}."],
  ltv: ["LTV", "Loan to value : part de l'opération financée par la dette.", "Ici : {deal.ltv|pct0}."],
  ilat: ["ILAT", "Indice des loyers des activités tertiaires (INSEE), sert à indexer les loyers de bureaux.", "Dernière valeur : {index.ilat|dec}."],
  qca: ["QCA", "Quartier central des affaires : le secteur de bureaux le plus central et le plus recherché d'un marché, où loyers et valeurs sont les plus élevés.", ""],
  dvf: ["DVF", "Demandes de valeurs foncières : base publique des ventes immobilières (prix, surface, date), sans les loyers.",
        "Ici : {market.dvf_price_per_sqm:n|int} transactions retenues."],
  dpe: ["DPE", "Diagnostic de performance énergétique, de A (sobre) à G (énergivore).", "Ici : {deal.dpe_current} aujourd'hui, objectif {deal.dpe_target}."],
  franchise: ["Franchise", "Période sans loyer accordée au locataire à la signature : réduit le loyer économique.", "Ici : {market.rents.incentives_months|months}."],
  incentive: ["Mesures d'accompagnement (incentives)", "Avantages consentis au locataire (franchise, travaux), en part de la valeur du bail ferme.", ""],
  marge: ["Marge sur coût", "(valeur nette de sortie − coût total) ÷ coût total.", "Ici : {financials.margin_pct|pct}, soit {financials.margin_eur|meur}."],
  maxprice: ["Prix maximum", "Prix d'acquisition le plus élevé qui respecte encore les objectifs du fonds (TRI fonds propres et marge).", "Ici : {financials.max_price.central|meur}."],
};
function term(id, text) { const g = GLOSSARY[id]; return g ? `<abbr class="term" title="${esc(g[1])}">${esc(text || g[0])}</abbr>` : esc(text); }

// ================================================================== outils : blocs repliés, SVG
// A3 : bloc repliable FERMÉ par défaut (aucun attribut open) avec une ligne-résumé portant son chiffre clé
const fold = (id, title, key, body) => `<details class="fold" id="${id}"><summary><span class="sum-title">${title}</span>${key ? `<span class="sum-key">${key}</span>` : ""}</summary><div class="fold-body">${body}</div></details>`;
const T = (x, y, s, cls = "lab", anchor = "start", extra = "") => `<text x="${x}" y="${y}" class="${cls}" text-anchor="${anchor}" ${extra}>${esc(s)}</text>`;
const V = (x, y, s, key, anchor = "start", extra = "") => `<text x="${x}" y="${y}" class="val" data-key="${esc(key)}" text-anchor="${anchor}" ${extra}>${esc(s)}</text>`;
const svg = (w, h, body, aria) => `<svg viewBox="0 0 ${w} ${h}" role="img" aria-label="${esc(aria || "")}">${body}</svg>`;
function niceTicks(min, max, n = 4) {
  const span = max - min || Math.abs(max) || 1, step0 = span / n, mag = Math.pow(10, Math.floor(Math.log10(step0)));
  const step = [1, 2, 2.5, 5, 10].map(m => m * mag).find(s => span / s <= n) || 10 * mag;
  const out = []; for (let v = Math.ceil(min / step) * step; v <= max + 1e-9; v += step) out.push(+v.toFixed(10)); return out;
}
// E12 : étiquettes d'axe sans chevauchement — on n'en garde une que si elle ne touche pas la précédente ; la dernière est prioritaire
// chaque étiquette occupe [gauche, droite] selon son ancrage (première : début, dernière : fin, autres : milieu) ;
// on n'en garde une que si elle laisse un blanc avec la précédente ; la dernière est toujours gardée
function spacedLabels(items, minGap, charW = 8) {
  const n = items.length, ext = (it, i) => { const w = String(it.t).length * charW; return i === 0 ? [it.x, it.x + w] : i === n - 1 ? [it.x - w, it.x] : [it.x - w / 2, it.x + w / 2]; };
  const out = [];
  items.forEach((it, i) => {
    const [l] = ext(it, i), prev = out[out.length - 1];
    if (!prev || l - prev.r >= minGap) out.push({ ...it, i, r: ext(it, i)[1] });
    else if (i === n - 1) { while (out.length > 1 && l - out[out.length - 1].r < minGap) out.pop(); out.push({ ...it, i, r: it.x }); }
  });
  return out.map(o => ({ x: o.x, t: o.t, anchor: o.i === 0 ? "start" : o.i === n - 1 ? "end" : "middle" }));
}
const LV = { "critique": "--lvl-critique", "élevé": "--lvl-eleve", "modéré": "--lvl-modere", "faible": "--lvl-faible", "incertain": "--lvl-incertain" };
const negStyle = v => (isNum(v) && v < 0 ? `style="fill:${css("--neg")}"` : "");

// barres horizontales ; items : {label, key, field, format, color, missing}
function hbars(fig, items, { w = 640, row = 32, labelW = 230, refs = [] } = {}) {
  const vals = items.map(i => val(i.key, i.field)).filter(isNum).concat(refs.map(r => val(r.key, r.field)).filter(isNum));
  let lo = Math.min(0, ...vals), hi = Math.max(0, ...vals); const pad = (hi - lo) * 0.22 || 1; hi += pad; if (lo < 0) lo -= pad;
  const top = refs.length * 16 + 4, x0 = labelW, x1 = w - 12, X = v => x0 + (v - lo) / (hi - lo) * (x1 - x0), h = items.length * row + top + 10;
  let b = `<line class="axis" x1="${X(0)}" x2="${X(0)}" y1="${top}" y2="${h - 6}"/>`;
  items.forEach((it, i) => {
    const y = top + 2 + i * row, v = val(it.key, it.field);
    b += T(labelW - 8, y + row / 2 + 2, it.label, "lab", "end");
    if (!isNum(v)) { fig.use(it.key); b += `<text x="${X(0) + 6}" y="${y + row / 2 + 2}" class="lab" style="font-style:italic">${esc(it.missing || "non disponible")}</text>`; return; }
    const a = Math.min(X(0), X(v)), bw = Math.max(1, Math.abs(X(v) - X(0))), txt = fig.n(it.key, v, it.format);
    b += `<rect x="${a}" y="${y + 5}" width="${bw}" height="${row - 12}" rx="4" fill="${it.color || css("--c1")}"><title>${esc(it.label)} : ${esc(txt)}</title></rect>`;
    b += V(v >= 0 ? X(v) + 6 : X(v) - 6, y + row / 2 + 2, txt, it.key, v >= 0 ? "start" : "end", negStyle(v));
  });
  refs.forEach((r, k) => {
    const v = val(r.key, r.field); if (!isNum(v)) return;
    const xr = X(v), ly = 12 + k * 16, end = xr > w - 200, txt = fig.n(r.key, v, r.format);
    b += `<line x1="${xr}" x2="${xr}" y1="${ly + 3}" y2="${h - 6}" stroke="${r.color}" stroke-dasharray="4 3"/>`;
    b += `<text x="${end ? xr - 4 : xr + 4}" y="${ly}" class="val" data-key="${esc(r.key)}" text-anchor="${end ? "end" : "start"}" style="fill:${r.color};font-weight:500">${esc(r.label + " " + txt)}</text>`;
  });
  return svg(w, h, b, items.map(i => i.label).join(", "));
}
// série temporelle (E12 : trois graduations, étiquettes de dates espacées)
function lineChart(fig, key, points, { w = 560, h = 230, format = "dec", refs = [], color } = {}) {
  fig.use(key);
  if (!points || points.length < 2) return `<p class="muted small">Série non disponible.</p>`;
  const vals = points.map(p => p.value).concat(refs.map(r => r.value).filter(isNum));
  let lo = Math.min(...vals), hi = Math.max(...vals); const pad = (hi - lo) * 0.18 || Math.abs(hi) * 0.05 || 1; lo -= pad; hi += pad;
  const L = 62, R = w - 16, Tp = 22, B = h - 30, X = i => L + i / (points.length - 1) * (R - L), Y = v => B - (v - lo) / (hi - lo) * (B - Tp);
  const f = FORMATS[format] || FORMATS.dec;
  let b = "";
  niceTicks(lo, hi, 3).forEach(t => { b += `<line class="gridl" x1="${L}" x2="${R}" y1="${Y(t)}" y2="${Y(t)}"/>` + T(L - 8, Y(t) + 4, f(t), "tick", "end"); });
  spacedLabels(points.map((p, i) => ({ x: X(i), t: p.date })), 14).forEach(it => { b += T(it.x, h - 8, it.t, "tick", it.anchor); });
  const lp = points[points.length - 1], ly = Y(lp.value);
  refs.forEach(r => {
    if (!isNum(r.value)) return;
    const yr = Y(r.value), above = yr - 6 > Tp && Math.abs(yr - 6 - (ly - 10)) > 14;
    b += `<line x1="${L}" x2="${R}" y1="${yr}" y2="${yr}" stroke="${r.color || css("--muted")}" stroke-dasharray="4 3"/>`
       + `<text x="${L + 6}" y="${above ? yr - 6 : yr + 15}" class="val" data-key="${esc(r.key)}" style="fill:${r.color || css("--muted")};font-weight:500">${esc(r.label + " " + fig.n(r.key, r.value, format))}</text>`;
  });
  b += `<polyline fill="none" stroke="${color || css("--c1")}" stroke-width="2.2" points="${points.map((p, i) => `${X(i)},${Y(p.value)}`).join(" ")}"/>`;
  b += `<circle cx="${X(points.length - 1)}" cy="${ly}" r="4" fill="${color || css("--c1")}"/>` + V(X(points.length - 1) - 8, ly < Tp + 14 ? ly + 18 : ly - 10, fig.n(key, lp.value, format), key, "end");
  points.forEach((p, i) => { b += `<circle cx="${X(i)}" cy="${Y(p.value)}" r="7" fill="transparent"><title>${esc(p.date)} : ${esc(f(p.value))}</title></circle>`; });
  return svg(w, h, b, "série");
}
// F17 : effet sur la marge quand une hypothèse varie seule dans sa fourchette (points calculés par l'agent)
function sweepChart(key, title, xFormat, centralKey) {
  const fig = Fig(), pts = val(key); fig.use(key);
  if (!Array.isArray(pts) || pts.length < 2) return `<div class="card"><h3 class="small">${title}</h3><p class="muted small">Non disponible ${fmt(key)}.</p></div>`;
  const W = 400, H = 180, L = 48, R = W - 16, Tp = 26, B = H - 34;
  const xs = pts.map(p => p.x), ys = pts.map(p => p.margin_pct).filter(isNum), c = val(centralKey);
  let lo = Math.min(0, ...ys), hi = Math.max(0, ...ys); const pad = (hi - lo) * 0.18 || 0.02; lo -= pad; hi += pad;
  const X = x => L + (x - xs[0]) / (xs[xs.length - 1] - xs[0]) * (R - L), Y = v => B - (v - lo) / (hi - lo) * (B - Tp);
  let b = `<line class="axis" x1="${L}" x2="${R}" y1="${Y(0)}" y2="${Y(0)}"/>` + T(L - 6, Y(0) + 4, "0 %", "tick", "end");
  b += `<polyline fill="none" stroke="${css("--c1")}" stroke-width="2.2" points="${pts.filter(p => isNum(p.margin_pct)).map(p => `${X(p.x)},${Y(p.margin_pct)}`).join(" ")}"/>`;
  [0, pts.length - 1].forEach((i, j) => {
    const p = pts[i]; if (!isNum(p.margin_pct)) return;
    const nb = pts[j ? pts.length - 2 : 1], yy = Y(p.margin_pct), below = isNum(nb.margin_pct) && Y(nb.margin_pct) < yy, ty = below || yy - 10 < Tp ? yy + 18 : yy - 10;
    b += `<circle cx="${X(p.x)}" cy="${yy}" r="3.5" fill="${css("--c1")}"/>` + V(X(p.x) + (j ? -4 : 4), ty, fig.n(key, p.margin_pct, "pct"), key, j ? "end" : "start", negStyle(p.margin_pct))
       + T(X(p.x), H - 10, (FORMATS[xFormat] || FORMATS.dec)(p.x), "tick", j ? "end" : "start");
  });
  if (isNum(c) && c >= Math.min(...xs) && c <= Math.max(...xs)) { fig.use(centralKey); b += `<line x1="${X(c)}" x2="${X(c)}" y1="${Tp - 4}" y2="${B}" stroke="${css("--ink")}" stroke-dasharray="3 3"/>` + T(X(c), Tp - 8, "central", "tick", "middle"); }
  return `<div class="card"><h3 class="small">${title}</h3>${svg(W, H, b, title)}${fig.caption("Marge sur coût quand l'hypothèse varie seule dans sa fourchette. ")}</div>`;
}

// ================================================================== données de base
const REC = D.recommendation, FIN = D.financials, MK = D.market, SENS = D.sensitivity, TG = D.targets;
const targetNote = () => TG.source === "assumption" ? `<span class="small muted"> (objectifs fixés par hypothèse)</span>` : "";
const missingKey = key => { const dp = dpOf(key); return !dp || dp.status === "missing" || dp.status === "rejected" || dp.value === null; };
const sortedTornado = metric => (val(`sensitivity.tornado.${metric}`) || []).slice().sort((a, b) => Math.abs(b.delta_high - b.delta_low) - Math.abs(a.delta_high - a.delta_low));
// F16 : donnée clé manquante -> valeur de repli et son effet sur la marge (lu dans le tornado)
function keyMissingBox(missKey, what, fallbackKey, fallbackFormat, tornadoVar) {
  if (!missingKey(missKey)) return "";
  const tk = "sensitivity.tornado.margin_pct", arr = val(tk) || [], i = arr.findIndex(r => r.variable === tornadoVar);
  const effect = i >= 0 ? ` Effet sur la marge si cette valeur se dégrade : ${fmt(tk, { field: [i, "delta_low"], format: "pts" })} ; si elle s'améliore : ${fmt(tk, { field: [i, "delta_high"], format: "pts" })} (bornes des sensibilités).` : "";
  return `<div class="box keymiss" role="note"><h4>Donnée clé manquante : la conclusion repose sur une valeur de repli</h4><span class="prose">${esc(what)} : ${fmt(missKey)}. Valeur retenue à la place : ${fmt(fallbackKey, { format: fallbackFormat })}.${effect}</span></div>`;
}

// ================================================================== C. verdict
const DECISION = {
  GO: { label: "GO", icon: "✓", sub: "les objectifs du fonds sont atteints" },
  GO_AVEC_CONTRAINTES: { label: "GO AVEC CONTRAINTES", icon: "✓!", sub: "objectifs atteints, mais le prix doit être négocié avant de s'engager" },
  GO_SOUS_CONDITIONS: { label: "GO SOUS CONDITIONS", icon: "!", sub: "des conditions doivent être levées avant validation" },
  NO_GO: { label: "NO-GO", icon: "✕", sub: "l'opération ne respecte pas les règles du fonds au prix demandé" },
  NON_DETERMINE: { label: "NON DÉTERMINÉ", icon: "?", sub: "des données nécessaires à la décision manquent" },
};
const CAT = { "marché_locatif": ["marché locatif", "⌂"], "travaux": ["travaux", "⚒"], "financier": ["taux et financement", "€"],
              "réglementaire": ["réglementation", "§"], "environnemental": ["environnement", "❦"] };
function priceBar() {
  const fig = Fig(), ask = val("deal.asking_price_eur"), mp = val("financials.max_price.central"), fl = val("rules.negotiable_floor_price");
  const tg = val("rules.market_price_target");
  if (!isNum(ask)) return "";
  const hi = Math.max(ask, mp || 0) * 1.04, W = 760, L = 6, R = W - 6, X = v => L + Math.max(0, v) / hi * (R - L), H = 150, y = 58;
  let b = `<rect x="${L}" y="${y}" width="${X(ask) - L}" height="14" rx="7" fill="${css("--soft")}"/>`;
  if (isNum(fl)) b += `<rect x="${X(fl)}" y="${y}" width="${Math.max(1, X(ask) - X(fl))}" height="14" fill="${css("--cond-soft")}" stroke="${css("--cond")}" stroke-dasharray="3 2"><title>décote jugée négociable</title></rect>`;
  if (isNum(mp)) b += `<rect x="${L}" y="${y + 3}" width="${Math.max(2, X(mp) - L)}" height="8" rx="4" fill="${css("--c1")}"/>`;
  const marks = [[ask, "deal.asking_price_eur", "prix demandé", css("--ink"), "meur"], [fl, "rules.negotiable_floor_price", "plancher négociable", css("--cond"), "meur"],
                 [tg, "rules.market_price_target", "cible marché", css("--go"), "meur2"], [mp, "financials.max_price.central", "prix maximum", css("--c1"), "meur"]]
    .filter(m => isNum(m[0])).sort((a, b) => a[0] - b[0]);
  // étiquettes placées sur quatre lignes (dessous, dessus, plus bas, plus haut) sans chevauchement : largeur estimée du texte
  const rows = [{ ty: y + 48, y1: y, y2: y + 32, end: -1e9 }, { ty: 38, y1: 44, y2: y + 14, end: -1e9 },
                { ty: y + 72, y1: y, y2: y + 58, end: -1e9 }, { ty: 16, y1: 22, y2: y + 14, end: -1e9 }];
  marks.forEach(([v, k, t, col, f]) => {
    const label = t + " " + fig.n(k, v, f), w = label.length * 7.2, x = X(v);
    const anchor = x + w / 2 > R ? "end" : x - w / 2 < L ? "start" : "middle";
    const left = anchor === "end" ? x - w : anchor === "start" ? x : x - w / 2;
    const row = rows.find(r => left > r.end + 8) || rows[rows.length - 1];
    row.end = left + w;
    b += `<line x1="${x}" x2="${x}" y1="${row.y1}" y2="${row.y2}" stroke="${col}" stroke-width="2"/>`;
    b += `<text x="${x}" y="${row.ty}" class="val" data-key="${esc(k)}" text-anchor="${anchor}" style="fill:${col}">${esc(label)}</text>`;
  });
  return `<div class="pricebar">${svg(W, H, b, "prix maximum, plancher négociable et prix demandé, à l'échelle")}<div class="legend"><span><i style="background:${css("--c1")}"></i>prix maximum recommandé</span><span><i style="background:${css("--cond-soft")};border:1px dashed ${css("--cond")}"></i>décote jugée négociable sous le prix demandé</span>${isNum(tg) ? `<span><i style="background:${css("--go")}"></i>cible de négociation : prix sous la référence de marché au m²</span>` : ""}</div>${fig.caption()}</div>`;
}
function renderVerdict() {
