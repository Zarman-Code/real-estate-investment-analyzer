  $("tornado").innerHTML = svg(W, H, b, "tornado des sensibilités") + `<div class="legend"><span><i style="background:${css("--pos")}"></i>hypothèse optimiste</span><span><i style="background:${css("--neg")}"></i>hypothèse pessimiste</span><span>en points ; cliquer une barre l'applique au simulateur</span></div>`
