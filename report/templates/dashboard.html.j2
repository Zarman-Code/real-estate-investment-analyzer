  });
  const dpeCard = `<div class="card"><h3>Classes ${term("dpe", "DPE")} des bureaux voisins</h3>${svg(W, H, db, "distribution des classes DPE")}
    <p class="small">${fmt("energy.dpe_comparables", { field: "n_with_label", format: "int" })} DPE classés sur ${fmt("energy.dpe_comparables", { field: "n_dpe", format: "int" })} dans le rayon d'étude. Actif : ${fmt("deal.dpe_current")} aujourd'hui, objectif ${fmt("deal.dpe_target")}.</p>
