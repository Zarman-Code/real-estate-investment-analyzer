  const heatSummary = !mm.length ? "non disponibles" : anyReach ? "certaines combinaisons atteignent l'objectif de marge" : `aucune combinaison testée n'atteint l'objectif de marge de ${fmt("targets.min_margin_on_cost_pct")}`;
